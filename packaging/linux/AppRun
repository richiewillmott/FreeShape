#!/bin/sh
# Starts FreeShape from inside the AppImage.
HERE="$(dirname "$(readlink -f "$0")")"
# Qt uses the system's own display and OpenGL drivers. X11 (XWayland on Wayland desktops) is preferred, since
# FreeShape's OpenGL calls go through GLX; native Wayland (EGL) is the fallback when there's no X server.
if [ -z "${QT_QPA_PLATFORM:-}" ]; then
  if [ -n "${DISPLAY:-}" ]; then
    export QT_QPA_PLATFORM=xcb
  elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
    export QT_QPA_PLATFORM=wayland
    export PYOPENGL_PLATFORM="${PYOPENGL_PLATFORM:-egl}"
  fi
fi
exec "$HERE/usr/lib/freeshape/FreeShape" "$@"
